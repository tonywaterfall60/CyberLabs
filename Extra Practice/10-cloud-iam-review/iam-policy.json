{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReportingData",
      "Effect": "Allow",
      "Action": [
        "s3:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ComputeRead",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IdentityAdmin",
      "Effect": "Allow",
      "Action": [
        "iam:ListUsers",
        "iam:CreateAccessKey"
      ],
      "Resource": "*"
    }
  ]
}